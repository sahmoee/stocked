	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.jessieowens.Stocked</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stocked</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ChompAPIKey</key>
	<string>$(CHOMP_API_KEY)</string>
	<key>ClaudeAPIKey</key>
	<string>$(CLAUDE_API_KEY)</string>
	<key>ClaudeAPIURL</key>
	<string>$(CLAUDE_API_URL)</string>
	<key>ClaudeModel</key>
	<string>$(CLAUDE_MODEL)</string>
	<key>EdamamAppID</key>
	<string>$(EDAMAM_APP_ID)</string>
	<key>EdamamAppKey</key>
	<string>$(EDAMAM_APP_KEY)</string>
	<key>HomeBaseAPIKey</key>
	<string>$(HOMEBASE_API_KEY)</string>
	<key>HomeBaseURL</key>
	<string>$(HOMEBASE_URL</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>LogMealAPIToken</key>
	<string>$(LOGMEAL_API_TOKEN)</string>
	<key>MealDBBaseURL</key>
	<string>$(MEALDB_BASE_URL)</string>
	<key>NSCameraUsageDescription</key>
	<string>Stocked uses the camera to scan barcodes and receipts, and to snap plate photos of meals you cook.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Stocked reads nothing from Health; access is requested only to enable nutrition logging.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Stocked logs the estimated nutrition of meals you cook to Apple Health, when you turn this on in Preferences.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Stocked connects to your HomeBase server on your Mac to sync your pantry</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Stocked uses your location to determine close by stores. </string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Stocked listens for hands-free voice commands like next, back, and finish while you cook, only when you turn the mic on.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Stocked saves shared kitchen QR codes to your photo library so you can send them to others.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Stocked lets you choose photos from your library to add to recipes and pantry items.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Stocked uses speech recognition to understand voice commands during cooking mode. Recognition runs on device when supported.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Stocked sends you a daily brief and reminders about expiring items and your grocery list.</string>
	<key>NetworkTimeout</key>
	<string>$(NETWORK_TIMEOUT_REQUEST)</string>
	<key>RapidAPIKey</key>
	<string>$(RAPIDAPI_KEY)</string>
	<key>SpoonacularAPIKey</key>
	<string>$(SPOONACULAR_API_KEY)</string>
	<key>StockedEnv</key>
	<string>$(STOCKED_ENV)</string>
	<key>StockedWorkerKey</key>
	<string>$(STOCKED_WORKER_KEY)</string>
	<key>SuggesticAPIToken</key>
	<string>$(SUGGESTIC_API_TOKEN)</string>
