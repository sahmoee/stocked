// Secrets.xcconfig — append these to Stocked's EXISTING Secrets.xcconfig
// (git-ignored; exposed to the app via Info.plist $(VAR) entries — guide §2.2–2.3).
//
// NOTE the $() trick: "//" starts a comment in xcconfig, so plain URLs break.

HOMEBASE_URL = http:/$()/sowens-mac.your-tailnet.ts.net:8080
HOMEBASE_API_KEY = hb_paste_key_from_HomeBase_Projects_and_Keys
