# Stocked content — caching, CORS, and MIME for static JSON + images served from cPanel.
# Place this file inside public_html/content/ (it only affects this folder).

# Allow the app (and browsers) to read these files from anywhere.
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
</IfModule>

# Correct content types.
AddType application/json .json
AddType image/webp .webp

# Cache policy. The app revalidates JSON with ETag, so a short JSON cache is ideal
# while images can be cached for a long time (they're versioned by filename).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Compress JSON on the wire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Keep ETags on (Apache default) so the app can send If-None-Match and get cheap 304s.
FileETag MTime Size
