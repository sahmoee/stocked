// Copy to ignored Secrets.xcconfig and configure only the providers you use.

// Optional development credentials; keep this checked-in example empty.
SPOONACULAR_API_KEY =

EDAMAM_APP_ID  =
EDAMAM_APP_KEY =

USDA_API_KEY =
STOCKED_WORKER_KEY =
RAPIDAPI_KEY =
API_NINJAS_KEY =
SUGGESTIC_API_TOKEN =
CHOMP_API_KEY =
LOGMEAL_API_TOKEN =

// Hosted intelligence uses the Worker; provider credentials stay server-side.
MEALDB_BASE_URL = https:$()/$()/www.themealdb.com/api/json/v1/1
NETWORK_TIMEOUT_REQUEST = 8
STOCKED_ENV = release

// ── HomeBase (optional local dev server) ─────────────────────────────────────
// NOTE the $() trick: "//" starts a comment in xcconfig, so plain URLs break.
HOMEBASE_URL =
HOMEBASE_API_KEY =
