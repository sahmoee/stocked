// Secrets.example.xcconfig
// ─────────────────────────────────────────────────────────────────────────────
// TEMPLATE — safe to commit. Copy this to "Secrets.xcconfig" (which IS gitignored) and
// fill in real values. This documents every key the app expects so nobody has to guess.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//   # then edit Secrets.xcconfig with your real keys
// ─────────────────────────────────────────────────────────────────────────────

SPOONACULAR_API_KEY = your_spoonacular_key

EDAMAM_APP_ID  = your_edamam_app_id
EDAMAM_APP_KEY = your_edamam_app_key

USDA_API_KEY =

// CLAUDE_API_KEY removed (2026-07): all AI goes through the Stocked Worker; no
// Anthropic key ships in the app. Set STOCKED_WORKER_KEY instead.
MEALDB_BASE_URL = https:$()/$()/www.themealdb.com/api/json/v1/1
NETWORK_TIMEOUT_REQUEST = 8
STOCKED_ENV = release
